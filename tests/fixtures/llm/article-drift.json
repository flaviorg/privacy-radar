      "prompt": "draft-narrative.v1",
      "when": {
        "document": "dpia",
        "section": "necessity-proportionality"
      },
      "output": {
        "paragraphs": [
          "A finalidade do tratamento segue os artigos 5 e 9 para os prontuários."
