{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "privacy-radar",
          "version": "0.1.0",
          "informationUri": "https://github.com/flaviorg/privacy-radar",
          "fullDescription": {
            "text": "Finds personal data in a Node/TypeScript repository and the flows that carry it into risky sinks, mapped to LGPD and GDPR articles. This is not legal advice and not a complete assessment."
          },
          "rules": [
            {
              "id": "PR-LOG",
              "name": "Personal data reaches a log call",
              "shortDescription": {
                "text": "A source reaches a log sink"
              },
              "fullDescription": {
                "text": "A value classified as personal data is passed to a logging call. Logs are copied to collectors, dashboards and backups, usually with weaker access control and no retention limit than the primary store. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Remove the value from the log call, log a surrogate identifier instead, or mask it before logging. Check who can read the logs and for how long they are kept.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Remove the value from the log call, log a surrogate identifier instead, or mask it before logging. Check who can read the logs and for how long they are kept.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-32"
                ],
                "precision": "medium",
                "security-severity": "8.0"
              }
            },
            {
              "id": "PR-THIRD-PARTY",
              "name": "Personal data is sent to a third-party host",
              "shortDescription": {
                "text": "A source reaches an http sink with a literal host or a non-literal URL"
              },
              "fullDescription": {
                "text": "A value classified as personal data is sent in an HTTP request to a host outside the application, or to a URL the scan could not resolve. Art. 28 applies if the vendor acts as a processor; verify the vendor's role, because some vendors are independent controllers. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Confirm who operates the destination, what contract covers it and whether the data is needed. Relative first-party URLs are not reported.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Confirm who operates the destination, what contract covers it and whether the data is needed. Relative first-party URLs are not reported.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-28",
                  "gdpr:art-32"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-ANALYTICS",
              "name": "Personal data reaches an analytics SDK",
              "shortDescription": {
                "text": "A source reaches an analytics sink"
              },
              "fullDescription": {
                "text": "A value classified as personal data is passed to an analytics or monitoring SDK. Art. 28 applies if the vendor acts as a processor; verify the vendor's role, because an analytics vendor may be an independent controller. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Send pseudonymous identifiers instead of direct identifiers, confirm the purpose and legal basis, and check the vendor's data processing terms and hosting region.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Send pseudonymous identifiers instead of direct identifiers, confirm the purpose and legal basis, and check the vendor's data processing terms and hosting region.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-7",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-6",
                  "gdpr:art-28"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-FILE",
              "name": "Personal data is written to a file",
              "shortDescription": {
                "text": "A source reaches a file sink"
              },
              "fullDescription": {
                "text": "A value classified as personal data is written to a file by the application. Files on local disks often escape the access control, encryption and retention rules of the main database. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Check where the file lives, who can read it, whether it is encrypted and when it is deleted. Prefer the primary data store.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Check where the file lives, who can read it, whether it is encrypted and when it is deleted. Prefer the primary data store.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-32"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-URL-QUERY",
              "name": "Personal data is placed in a URL query string",
              "shortDescription": {
                "text": "A source is interpolated into a URL query string"
              },
              "fullDescription": {
                "text": "A value classified as personal data is written into the query string of a URL. Query strings end up in server logs, browser history, proxies and referrer headers. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Send the value in the request body or a header over TLS, or use an opaque token. Remove the value from URLs that are logged or shared.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Send the value in the request body or a header over TLS, or use an opaque token. Remove the value from URLs that are logged or shared.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-32"
                ],
                "precision": "medium",
                "security-severity": "8.0"
              }
            },
            {
              "id": "PR-TRANSFER",
              "name": "Personal data may be transferred internationally",
              "shortDescription": {
                "text": "A source reaches a known vendor whose transfer status needs a mechanism or is conditional"
              },
              "fullDescription": {
                "text": "A value classified as personal data reaches a vendor that is outside the selected regime's domestic and adequate destinations, so an international transfer mechanism is needed or must be verified. Adequacy status is dated data and goes stale. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Identify the transfer mechanism (adequacy, certification, standard clauses, binding rules or consent), record it under vendors in the project config and verify the contract.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Identify the transfer mechanism (adequacy, certification, standard clauses, binding rules or consent), record it under vendors in the project config and verify the contract.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-33",
                  "lgpd:art-34",
                  "lgpd:art-35",
                  "lgpd:art-36",
                  "gdpr:art-44",
                  "gdpr:art-45",
                  "gdpr:art-46",
                  "gdpr:art-47",
                  "gdpr:art-49"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-PLAINTEXT-SENSITIVE",
              "name": "Sensitive field stored without protection",
              "shortDescription": {
                "text": "A storage field classified as sensitive has no hash, encryption or row-level protection hint"
              },
              "fullDescription": {
                "text": "A table or model field classified as sensitive personal data is a plain text-like column with no sign of hashing, encryption or row-level security. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Consider column-level encryption, a separate protected table, row-level security or tokenisation. A name suffix, a comment or an attribute that marks the field as protected clears this finding.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Consider column-level encryption, a separate protected table, row-level security or tokenisation. A name suffix, a comment or an attribute that marks the field as protected clears this finding.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-25",
                  "gdpr:art-32"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-RETENTION",
              "name": "Storage entity has no retention signal",
              "shortDescription": {
                "text": "A storage entity with personal fields has no retention signal"
              },
              "fullDescription": {
                "text": "A table or model with personal data fields shows no retention mechanism: no deletion or expiry timestamp, no purge field and no retention period declared in the project config. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Define how long the data is needed, add an expiry or deletion mechanism, and declare the period under retention in the project config.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Define how long the data is needed, add an expiry or deletion mechanism, and declare the period under retention in the project config.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-15",
                  "lgpd:art-16",
                  "gdpr:art-5",
                  "gdpr:art-30"
                ],
                "precision": "medium",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-CHILD",
              "name": "Possible children's data indicator",
              "shortDescription": {
                "text": "A storage entity has a children indicator"
              },
              "fullDescription": {
                "text": "A table or model has fields that suggest it may hold data about children or adolescents, such as a guardian, a school or a minor flag. The tool never asserts that a data subject is a minor. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Confirm whether minors are in scope, which legal basis applies, and whether parental consent and age checks are in place.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Confirm whether minors are in scope, which legal basis applies, and whether parental consent and age checks are in place.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-14",
                  "gdpr:art-8",
                  "gdpr:recital-38",
                  "gdpr:recital-75"
                ],
                "precision": "medium",
                "security-severity": "2.0"
              }
            },
            {
              "id": "PR-HARDCODED-VALUE",
              "name": "Personal data value hard-coded in a file",
              "shortDescription": {
                "text": "A file holds a checksum-valid personal value or an e-mail address"
              },
              "fullDescription": {
                "text": "A scanned file contains a literal that passes an identifier checksum, or an e-mail address. Real values in source control are copied to every clone, fork and backup. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Move the value to a secret store or replace it with synthetic test data. Rotate or delete the value if it is real.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Move the value to a secret store or replace it with synthetic test data. Rotate or delete the value if it is real.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-6",
                  "lgpd:art-46",
                  "gdpr:art-5",
                  "gdpr:art-32"
                ],
                "precision": "high",
                "security-severity": "5.0"
              }
            },
            {
              "id": "PR-AMBIGUOUS",
              "name": "Ambiguous field labeled as personal data by the LLM",
              "shortDescription": {
                "text": "The LLM labeled an ambiguous field with a personal category"
              },
              "fullDescription": {
                "text": "A field with a generic name was labeled by the language model as a personal data category. The label is advisory: it never changes a deterministic finding, a severity or an article. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Review the field and decide whether it holds personal data. Treat the label as a prompt for human review, not as a result.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Review the field and decide whether it holds personal data. Treat the label as a prompt for human review, not as a result.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "privacy",
                  "lgpd:art-5",
                  "gdpr:art-4"
                ],
                "precision": "low",
                "security-severity": "2.0"
              }
            },
            {
              "id": "PR-PARSE",
              "name": "A file could not be fully parsed",
              "shortDescription": {
                "text": "A file produced a parse, depth or dialect warning"
              },
              "fullDescription": {
                "text": "A file could not be parsed completely, so part of it was not scanned. The scan continued with the other files. This is not legal advice and not a complete assessment."
              },
              "help": {
                "text": "Fix the syntax error or exclude the file with the ignore list. Unsupported SQL dialects need a PostgreSQL export of the schema.\n\nThis is not legal advice and not a complete assessment.",
                "markdown": "Fix the syntax error or exclude the file with the ignore list. Unsupported SQL dialects need a PostgreSQL export of the schema.\n\nThis is not legal advice and not a complete assessment."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "privacy"
                ],
                "precision": "medium",
                "security-severity": "2.0"
              }
            }
          ]
        }
      },
