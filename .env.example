# Copy to .env for local use (.env is ignored by Git). `npm test` never reads it.

# fake (scripted fixtures, default), openai-compatible, anthropic (planned) or none
LLM_PROVIDER=fake
# Required with openai-compatible; never printed, never logged
LLM_API_KEY=
# OpenAI-compatible base URL (OpenAI https://api.openai.com/v1, local http://localhost:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Required with openai-compatible
LLM_MODEL=
# Timeout of each model call, in milliseconds
LLM_TIMEOUT_MS=30000
# Fake provider fixture, resolved against the current directory; empty or missing degrades the scan to --llm none
LLM_FIXTURE=
# Maximum number of files one scan reads
PRIVACY_RADAR_MAX_FILES=5000
# ISO date that freezes generatedAt, the document banner date and the demo commit dates; empty uses real time
PRIVACY_RADAR_CLOCK=
# Seed of the property-style test generators (CI uses 20261008); empty uses the default
PROPERTY_SEED=
# debug, info, warn or error
LOG_LEVEL=info
